# ---- MedPilot API environment ----------------------------------------------
# Copy to .env for development. Production values live in the deployment
# platform's secret store — never in this repository.

NODE_ENV=development                 # development | staging | production | test
PORT=3000
API_PUBLIC_URL=http://localhost:3000 # external base URL (signed upload/download links)

# Database (project-local Postgres in development)
DATABASE_URL=postgres://medpilot@localhost:5433/medpilot_dev

# Auth — RS256 signing keys. In development, generated into ./keys on first
# boot when unset. In staging/production these MUST be provided (PEM, \n-escaped).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SEC=900             # 15 min
REFRESH_TOKEN_TTL_DAYS=60

# Secondary HMAC secret: upload/download link signing, verification-token pepper
APP_SECRET=change-me-32-bytes-minimum-random

# Storage driver: local (dev) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
S3_BUCKET_PHI=
S3_BUCKET_MEDIA=
S3_BUCKET_PUBLIC=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email driver: outbox (dev: writes ./var/outbox) | smtp-provider
EMAIL_DRIVER=outbox
EMAIL_FROM=no-reply@medpilot.app

# AUX AI driver: deterministic (dev rule-based) | llm
AUX_DRIVER=deterministic
LLM_API_KEY=
LLM_MODEL=

# Billing receipt verification: mock (dev) | apple+google
BILLING_DRIVER=mock

# Push driver: console (dev) | expo
PUSH_DRIVER=console
EXPO_ACCESS_TOKEN=

# Free-tier quotas (per calendar month)
QUOTA_MEAL_ANALYSIS=1
QUOTA_CLINIC_ACCESS=10
QUOTA_EVACUATION=2
