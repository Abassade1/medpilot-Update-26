# =============================================================================
# MedPilot API — environment template
# =============================================================================
# Copy to .env for development. Staging and production values belong in the
# deployment platform's secret store, never in this repository.
#
# Every value below is a PLACEHOLDER. No real credential is committed here.
#
# Each environment must have its OWN database, buckets, SMTP account, store
# credentials and secrets. Staging must never be pointed at production data,
# and development must never be given production credentials.
#
# Outside development the process refuses to start on a development driver
# (see assertDeployableDrivers in src/config/env.ts), so a misconfigured
# deploy fails immediately instead of silently losing email or files.
# -----------------------------------------------------------------------------

# ---- Core -------------------------------------------------------------------
NODE_ENV=development                  # development | staging | production | test
PORT=3000
API_PUBLIC_URL=http://localhost:3000  # external base URL; must be https when deployed
WEB_PUBLIC_URL=                       # https base for email verify/reset links; REQUIRED when deployed
WEB_PORTAL_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # CORS allowlist for the institutional provider web portal

# ---- Database ---------------------------------------------------------------
# One database per environment. Never share a cluster role between them.
DATABASE_URL=postgres://medpilot@localhost:5433/medpilot_dev
TEST_DATABASE_URL=postgres://medpilot@localhost:5433/medpilot_test

# ---- Authentication ---------------------------------------------------------
# RS256 signing keys. Generated into ./keys on first boot in development;
# REQUIRED outside it. PEM with literal \n escapes, or mount and read from disk.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SEC=900              # 15 minutes
REFRESH_TOKEN_TTL_DAYS=60

# Secondary HMAC secret: upload/download link signing, verification-token pepper.
# Generate with: openssl rand -hex 32 — and use a DIFFERENT value per environment.
APP_SECRET=change-me-32-bytes-minimum-random

# ---- Storage ----------------------------------------------------------------
# local = the API's own disk (development only — does not survive a redeploy).
# s3    = object storage; REQUIRED when deployed.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage

# Buckets MUST block all public access. Uploads and downloads are proxied and
# authorised by this API, so the buckets never need to be internet-reachable.
# Use separate buckets per environment; PHI must not share a bucket with media.
S3_REGION=
S3_ENDPOINT=                          # only for S3-compatible providers
S3_FORCE_PATH_STYLE=false
S3_BUCKET_PHI=                        # medical records, meal photos
S3_BUCKET_MEDIA=                      # non-clinical media
S3_BUCKET_PUBLIC=                     # optional; falls back to media
S3_ACCESS_KEY_ID=                     # omit to use the instance role
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256                         # AES256 | aws:kms — must not be empty when deployed
S3_SSE_KMS_KEY_ID=                    # required only when S3_SSE=aws:kms

# ---- Email ------------------------------------------------------------------
# outbox = writes JSON to ./var/outbox (development only — reaches nobody).
# smtp   = real delivery; REQUIRED when deployed. Provider needs a BAA.
EMAIL_DRIVER=outbox
EMAIL_FROM=no-reply@medpilot.example
EMAIL_FROM_NAME=MedPilot
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587                         # 587 with STARTTLS, or 465 with SMTP_SECURE=true
SMTP_SECURE=false                     # true = implicit TLS (port 465)
SMTP_REQUIRE_TLS=true                 # STARTTLS mandatory on 587 — keep true
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_INSECURE=false             # skips TLS verification; local test servers ONLY

# ---- AUX assistant ----------------------------------------------------------
# deterministic = rule-based responses (safe, but not the product).
# llm           = NOT IMPLEMENTED; blocked on model/prompt/clinical-review decisions.
AUX_DRIVER=deterministic
LLM_API_KEY=
LLM_MODEL=

# ---- Purchases --------------------------------------------------------------
# mock  = accepts any well-formed receipt (development only).
# store = verifies against Apple and Google; REQUIRED when deployed.
BILLING_DRIVER=mock

# Apple: StoreKit 2 signed transactions are verified against Apple's signing
# chain. Sandbox and Production transactions are rejected across environments.
APPLE_BUNDLE_ID=
APPLE_ENVIRONMENT=Sandbox             # Sandbox | Production
APPLE_ROOT_CA_PATH=                   # Apple Root CA G3 PEM; falls back to a pinned fingerprint

# Google Play: a service account with the "View financial data" permission.
GOOGLE_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=           # PEM private key, \n-escaped

# ---- Push notifications -----------------------------------------------------
# console = logs instead of delivering (development only).
# expo    = Expo Push; REQUIRED when deployed.
PUSH_DRIVER=console
EXPO_ACCESS_TOKEN=

# ---- Free-tier quotas (per calendar month) ----------------------------------
QUOTA_MEAL_ANALYSIS=1
QUOTA_CLINIC_ACCESS=10
QUOTA_EVACUATION=2

# ---- Booking completion -------------------------------------------------------
# Minutes between sweeps that mark confirmed bookings completed once their date has
# passed (and ask the member to rate the visit). 0 disables the sweep.
COMPLETION_SWEEP_MINUTES=60
# Minutes between sweeps that send a reminder the day before each confirmed booking
# (members can turn these off in their profile). 0 disables reminders.
REMINDER_SWEEP_MINUTES=60

# Development only: skip staff review of new provider accounts (ignored in production)
# PROVIDER_AUTO_VERIFY=true
